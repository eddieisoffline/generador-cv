{
  "name": "generador-cv",
  "version": "1.1.0",
  "description": "Generador de CV que funciona entero en el navegador: PDF y Word, sin cuentas ni datos guardados.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eddieisoffline/generador-cv.git"
  },
  "bugs": {
    "url": "https://github.com/eddieisoffline/generador-cv/issues"
  },
  "homepage": "https://github.com/eddieisoffline/generador-cv#readme",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "profile-to-docx": "tsx scripts/profile-to-docx.ts",
    "check:links": "node scripts/check-links.mjs",
    "lighthouse": "lighthouse http://localhost:4173/ --only-categories=performance,accessibility,best-practices,seo --chrome-flags=--headless=new --output=html --output-path=./lighthouse-report.html"
  },
  "dependencies": {
    "@material-symbols/svg-400": "0.48.1",
    "docx": "9.14.0",
    "jszip": "3.10.2",
    "pdfmake": "0.3.12",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/pdfmake": "0.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "lighthouse": "13.5.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
